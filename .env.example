# Resend API key from https://resend.com
RESEND_API_KEY=

# Verified sender address (or use Resend onboarding address while testing)
CONTACT_FROM_EMAIL=Apex Construction <onboarding@resend.dev>

# Inbox that receives consultation, quote, and contact form submissions
CONTACT_TO_EMAIL=build@apexconstruction.com

# Canonical site URL used for SEO metadata, sitemap, and JSON-LD
NEXT_PUBLIC_SITE_URL=https://apexconstruction.com

# Optional: Google Search Console verification token (content= value of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Payload CMS
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgres://apex:apex@localhost:5433/apex

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
